# Google Gemini API Key
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model default (opsional: gemini-flash-latest, gemini-3.7-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-flash-latest

# Proxy Kemnaker Mandiri (default: https://api.mobogen.online)
# KEMNAKER_PROXY_BASE_URL=https://api.mobogen.online

# ==========================================
# Telegram Bot Configuration
# ==========================================
# Dapatkan dari @BotFather di aplikasi Telegram
TELEGRAM_BOT_TOKEN=
# String rahasia acak untuk keamanan webhook Telegram (opsional)
TELEGRAM_WEBHOOK_SECRET=mobogen_telegram_secret_2026

# Secret key untuk enkripsi kredensial user di database lokal/file (opsional)
TELEGRAM_ENCRYPTION_SECRET=ganti_dengan_random_secret_32_karakter

# Vercel Cron Secret (opsional untuk keamanan endpoint reminder)
CRON_SECRET=
